{
  "name": "tyrantofthedarkskies-frontend",
  "version": "1.0.0",
  "description": "Web client for Tyrant of the Dark Skies MUD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:screenshot": "playwright test tests/screenshot.spec.ts --headed",
    "screenshot": "npx playwright test tests/screenshot.spec.ts --headed"
  },
  "keywords": [
    "mud",
    "websocket",
    "game",
    "client",
    "react"
  ],
  "author": "",
